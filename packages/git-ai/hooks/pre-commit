#!/usr/bin/env bash
# pre-commit — dispatcher preserving repo-local hooks while core.hooksPath
# points at git-ai's bundled hook directory.

set -e

GIT_AI_HOOK_SELF="$0"
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=lib/local-hook-dispatch.sh
. "${SCRIPT_DIR}/lib/local-hook-dispatch.sh"

# Run the repository's own .git/hooks/pre-commit first. If it fails, propagate
# the failure and stop, matching Git's normal hook semantics.
git_ai_run_local_hook "pre-commit" "$@"

# git-ai currently has no pre-commit behavior; this hook exists so setting
# core.hooksPath to the git-ai hooks directory does not disable local hooks.
exit 0
