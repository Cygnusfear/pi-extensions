{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "allowJs": true,
    "baseUrl": "../..",
    "paths": {
      "@pi-extensions/shared/sandbox-registry": [
        "packages/shared/src/sandbox-registry.ts"
      ]
    }
  },
  "include": [
    "src/session-factory.ts",
    "src/persistent-store.ts"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
